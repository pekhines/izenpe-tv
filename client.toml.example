# Copy to ~/.config/izenpe-tv/client.toml and fill in the values extracted from the
# official Izenpe desktop app (TarjetaVirtual.exe). These are the app's embedded OAuth
# client credentials, not your personal credentials. Keep this file out of version control.
client_ids = ["<candidate1>", "<candidate2>"]
client_secret_prod = "<prod secret>"
client_secret_desa = "<desa secret>"
